NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_SECRET=
# Backend .NET chạy profile http (xem Properties/launchSettings.json)
NEXT_PUBLIC_API_URL=http://localhost:5041
API_URL=http://localhost:5041
# Đặt false để frontend gọi API thật thay vì dữ liệu mock
USE_MOCK_API=true
NEXT_PUBLIC_USE_MOCK_API=true
# Đặt true để giả lập lỗi like (phục vụ kiểm thử rollback optimistic update)
NEXT_PUBLIC_MOCK_LIKE_FAIL=false
# Google Social Login — để trống khi chưa dùng; NEXT_PUBLIC_GOOGLE_ENABLED
# chỉ điều khiển việc hiển thị nút "Đăng nhập với Google" (không lộ secret).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false
